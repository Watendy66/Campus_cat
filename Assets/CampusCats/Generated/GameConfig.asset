  diary:
  - "\u4E5D\u5C3E\u7EC8\u4E8E\u5141\u8BB8\u6211\u5B89\u9759\u5730\u4E3A\u5B83\u62CD\u4E86\u4E00\u5F20\u7167\u7247\u3002"
  - "\u8DDF\u7740\u4E5D\u5C3E\u8D70\u8FC7\u6559\u5B66\u697C\u4FA7\u9762\uFF0C\u6211\u8BB0\u4E0B\u4E86\u7B2C\u4E00\u6BB5\u8DEF\u7EBF\u3002"
  - "\u9ED1\u767D\u54AA\u4E00\u76F4\u76EF\u7740\u957F\u6905\u3002\u6211\u4ECE\u4E0B\u9762\u627E\u56DE\u4E86\u4E00\u9897\u5C0F\u7403\u3002"
  - "\u9ED1\u767D\u54AA\u6251\u5411\u5C0F\u7403\u7684\u77AC\u95F4\u88AB\u6211\u7559\u4E0B\u4E86\uFF0C\u82B1\u575B\u65C1\u7684\u5C0F\u8DEF\u662F\u7B2C\u4E8C\u6BB5\u7EBF\u7D22\u3002"
  - "\u653E\u4E0B\u98DF\u7269\u540E\u9000\u5F00\uFF0C\u9876\u6D41\u7EC8\u4E8E\u5B89\u5FC3\u5730\u5403\u4E86\u8D77\u6765\u3002"
  - "\u9876\u6D41\u5728\u6E56\u8FB9\u7B49\u6211\u62CD\u7167\uFF0C\u7B2C\u4E09\u6BB5\u8DEF\u7EBF\u63A5\u4E0A\u4E86\u3002"
  - "\u6CBF\u7740\u4E09\u6BB5\u8DEF\u7EBF\uFF0C\u6211\u627E\u5230\u4E86\u5B83\u4EEC\u5171\u540C\u7684\u5C0F\u7A9D\u3002"
  - "\u539F\u6765\u5B83\u4EEC\u6BCF\u5929\u90FD\u56DE\u5230\u8FD9\u91CC\u3002\u4E09\u53EA\u732B\uFF0C\u4E00\u5F20\u5408\u7167\uFF0C\u65B0\u7684\u4E00\u9875\u6821\u56ED\u65E5\u5E38\u3002"
